# ── IA (Gemini) ────────────────────────────────────────────────────────────────
# Mesma chave usada pelo site dos600ao1000.
GEMINI_API_KEY=
# Modelo preferido (vai primeiro na fila).
GEMINI_MODEL=gemini-3.5-flash
# Fila de modelos: usa o primeiro que tiver cota. Separe por virgula.
GEMINI_MODELOS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-pro-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest

# ── Meta (Facebook + Instagram) ────────────────────────────────────────────────
# IDs fixos das suas contas:
META_PAGE_ID=1537036239483766
META_IG_ID=17841475605177963
# Preenchido automaticamente por: npm run token <SEU_TOKEN>
META_PAGE_TOKEN=

# ── Hospedagem publica da imagem (o Instagram exige URL publica) ───────────────
# As imagens aprovadas sao empurradas para um repositorio PUBLICO e o Instagram
# busca por raw.githubusercontent.com. Nao ha codigo do produto aqui.
PUBLIC_IMAGE_REPO=https://github.com/jomavisa4/dos600aos1000-posts.git
PUBLIC_IMAGE_BASE=https://raw.githubusercontent.com/jomavisa4/dos600aos1000-posts/main

# ── Servidor local de aprovacao ────────────────────────────────────────────────
PORT=3737

# ── Agendamento (usado pelo servidor, se ele ficar aberto) ─────────────────────
# Horarios para gerar rascunhos automaticamente (HH:MM, separados por virgula).
POST_TIMES=09:00,13:00,19:00
POSTS_PER_RUN=1

# ── Conteudo ───────────────────────────────────────────────────────────────────
# Link da oferta (destino do CTA).
OFFER_URL=https://dos600aos1000.onrender.com
HANDLE=@dos600aos1000
